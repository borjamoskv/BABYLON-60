{
  "manifest_version": 3,
  "name": "Moskv-FX-Scavenger",
  "version": "1.0",
  "description": "Causal-Determinist Transducer for Google Labs FX (BABYLON-60)",
  "permissions": [
    "nativeMessaging",
    "activeTab"
  ],
  "host_permissions": [
    "*://labs.google/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Disparar Ping IPC"
  },
  "content_scripts": [
    {
      "matches": ["*://labs.google/*"],
      "js": ["content.js"]
    }
  ]
}
