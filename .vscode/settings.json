{
  "git.untrackedChanges": "hidden",
  "git.autorefresh": false,
  "git.decorations.enabled": false,
  "files.watcherExclude": {
    "**/.git/objects": true,
    "**/.git/subtree-cache": true,
    "**/node_modules": true,
    "**/.venv": true,
    "**/target": true,
    "**/.cortex": true,
    "**/__pycache__": true
  },
  "search.exclude": {
    "**/node_modules": true,
    "**/.venv": true,
    "**/target": true,
    "**/.cortex": true,
    "**/__pycache__": true,
    "**/scratch/**/*.log": true,
    "**/*.db": true
  }
}
