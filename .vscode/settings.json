{
  "git.untrackedChanges": "hidden",
  "git.autorefresh": false,
  "git.decorations.enabled": false,
  "files.watcherExclude": {
    "**/.git/objects": true,
    "**/.git/subtree-cache": true,
    "**/node_modules": true,
    "**/.venv": true,
    "**/target": true,
    "**/.cortex": true,
    "**/__pycache__": true,
    "**/.ruff_cache": true,
    "**/.mypy_cache": true,
    "**/.pytest_cache": true,
    "**/.vite": true,
    "**/out": true,
    "**/dist": true,
    "**/bin": true,
    "**/obj": true
  },
  "search.exclude": {
    "**/node_modules": true,
    "**/.venv": true,
    "**/target": true,
    "**/.cortex": true,
    "**/__pycache__": true,
    "**/.ruff_cache": true,
    "**/.mypy_cache": true,
    "**/.pytest_cache": true,
    "**/.vite": true,
    "**/out": true,
    "**/dist": true,
    "**/bin": true,
    "**/obj": true,
    "**/scratch/**/*.log": true,
    "**/*.db": true
  }
}
