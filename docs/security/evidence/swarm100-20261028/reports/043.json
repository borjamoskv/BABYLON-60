      "title": "Reject path components before recursive extension deletion",
      "severity": "P1",
      "path": "tools/skill_library/global/c5-secops-infra-devtools/references/modules/c5-browser-forensics-and-extension-triage/scripts/browser_forensics.py",
      "line": 171,
      "evidence": "main passes required --id directly to cmd_purge (lines 257-270); cmd_purge only strips whitespace/nonempty checks (158-161), joins it into directory paths (171,179), then calls shutil.rmtree (173,181).",
      "trigger": "Run purge with an absolute directory path as --id or a traversal such as ../.. while a Chrome profile exists.",
      "impact": "The locally invoked cleanup command can recursively delete a user-accessible directory outside the extension directory. This is an unsafe CLI input boundary, not a claim of remote exploitation.",
      "confidence": "high",
      "kind": "runtime"
    },
    {
      "title": "Preserve a statement when removing a sole docstring",
      "severity": "P2",
      "path": "01_KISH_ENGINE/babylon60/core/thermo_ast_pruner.py",
      "line": 16,
      "evidence": "visit_Expr returns None for every constant expression (16-18); transmute_file writes ast.unparse directly back to the source (80-87), with no repair for empty suites.",
      "trigger": "Prune a valid function or class whose only statement is a docstring, for example def f(): followed by its sole indented string literal.",
      "impact": "The transformed function/class has an empty body; its written source cannot be parsed/imported. Existing tests contain other statements and do not cover this case.",
      "confidence": "high",
      "kind": "runtime"
    },
    {
      "title": "Recognize imported bindings before suppressing required imports",
      "severity": "P2",
      "path": "01_KISH_ENGINE/babylon60/core/thermo_ast_pruner.py",
      "line": 60,
      "evidence": "_find_import_flags checks ast.alias.name but ignores asname, then visit_Module suppresses importing os/signal when those module names appeared (60-75). Injected handlers always reference bare os and signal (26-35).",
      "trigger": "Prune a module using import os as operating_system or import signal as sig and a broad exception handler.",
      "impact": "The injected handler raises NameError at its first missing bare binding instead of performing its intended fail-stop action.",
      "confidence": "high",
      "kind": "runtime"
    },
    {
      "title": "Return a lexical error for out-of-range integer literals",
      "severity": "P2",
      "path": "00_ABZU_KERNEL/crates/babylon60-compiler/src/parser.rs",
      "line": 57,
      "evidence": "Lexer::next_token collects arbitrary-length decimal text and invokes num.parse().expect(\"BFT Fallback\") rather than returning a recoverable error. Lexer and tokenize are public.",
      "trigger": "Pass an integer token larger than i64::MAX through Lexer::tokenize.",
      "impact": "Malformed source panics during lexing rather than producing a parser diagnostic; any caller without panic isolation loses its compilation request/process. No running service exposure established.",
      "confidence": "high",
      "kind": "runtime"
    },
    {
      "title": "Fail the audit gate when Python source cannot be parsed",
      "severity": "P2",
      "path": "tools/skill_library/global/existence-gap-audit/scripts/existence_gap.py",
      "line": 1253,
      "evidence": "extract_python records SyntaxError and performs only regex import salvage (232-239); analyse stores syntax_errors separately (1162); main --fail-on examines rep[\"findings\"] only (1253-1254), so syntax errors never affect exit status. render also prints an all-imports-resolve statement whenever findings is empty (1212-1213).",
      "trigger": "Audit a repository with a malformed Python source file containing no regex-recoverable imports, using --fail-on alto (or any severity).",
      "impact": "The command emits syntax diagnostics but exits zero and can print an all-imports-resolve message despite being unable to inspect the source; a CI consumer relying on the gate accepts incomplete audit coverage. This is a static control-flow result, not an executed reproduction.",
      "confidence": "high",
      "kind": "runtime"
    }
