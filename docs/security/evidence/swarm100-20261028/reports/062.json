{
  "shard": "062",
  "findings": [
    {
      "title": "Serialize ledger read-modify-append across writers",
      "severity": "P1",
      "path": "crates/babylon-attest/src/ledger.rs",
      "line": 123,
      "evidence": "append_event reads the entire chain at 123, derives index/prev_hash at 125-129, then opens an independent append handle at 160-166; no lock covers that interval. CLI main.rs:227 and :474 invoke this function.",
      "trigger": "Two processes append to the same existing ledger before either write completes.",
      "impact": "Both can acknowledge blocks with the same index and predecessor; verify_chain subsequently rejects index continuity.",
      "confidence": "high",
      "kind": "runtime"
    },
    {
      "title": "Sync committed ledger records before acknowledging success",
      "severity": "P1",
      "path": "crates/babylon-attest/src/ledger.rs",
      "line": 166,
      "evidence": "Only writeln! precedes Ok(block); no sync_data/sync_all or transactional durable commit exists. main.rs:230 displays ATTESTATION COMMITTED.",
      "trigger": "Storage or host failure after append_event returns but before OS cache reaches durable media.",
      "impact": "An acknowledged attestation can disappear or leave a partial final JSON line, preventing subsequent chain reads.",
      "confidence": "high",
      "kind": "runtime"
    },
    {
      "title": "Export the actual block hash algorithm",
      "severity": "P2",
      "path": "crates/babylon-attest/src/ledger.rs",
      "line": 273,
      "evidence": "append_event computes block_hash with BLAKE3 at 145; export_scitt_voucher unconditionally labels leaf_hash_algorithm SHA-256 at 273. main.rs:241 exports that voucher.",
      "trigger": "A newly appended block is requested using the SCITT output format.",
      "impact": "An independent consumer applying the declared hash algorithm cannot reproduce the advertised leaf commitment.",
      "confidence": "high",
      "kind": "runtime"
    },
    {
      "title": "Enforce the advertised subprocess timeout",
      "severity": "P2",
      "path": "01_KISH_ENGINE/babylon60/tools/context7_client.py",
      "line": 52,
      "evidence": "_call_tool accepts timeout=15 at 21 but never uses it; blocking readline at 52 and 77 and stderr.read at 54/79 have no deadline.",
      "trigger": "The Node MCP process starts but never emits a complete initialization/tool response, or keeps stderr open after stdout closes.",
      "impact": "CLI call hangs indefinitely and never reaches finally to terminate the child.",
      "confidence": "high",
      "kind": "runtime"
    },
    {
      "title": "Bind finding metadata into receipt verification",
      "severity": "P2",
      "path": "01_KISH_ENGINE/babylon60/bft/bounty_claim_attester.py",
      "line": 116,
      "evidence": "generate_receipt root at 96 uses only payload_hash and hardware hash; verify_receipt at 116-118 recomputes those same two leaves. claim_id/advisory_id/domain/finding_summary/risk_score/timestamp are excluded. compute_claim_hash includes them but its output is never compared by verify_receipt. Pipeline orchestrator imports/creates this attester at 24/86.",
      "trigger": "A receipt is copied with a different advisory, summary, risk score or timestamp while keeping its payload hash, hardware anchor and root.",
      "impact": "verify_receipt still returns true for altered claim metadata, despite documenting receipt hash coherence.",
      "confidence": "high",
      "kind": "runtime"
    },
    {
      "title": "Label simulated audit results instead of emitting verified passes",
      "severity": "P1",
      "path": "scripts/c5_sharur/sharur_100_swarm_execution.py",
      "line": 169,
      "evidence": "run_agent only awaits asyncio.sleep at 160 and returns constant PASS and silicon verification evidence at 169-172. It performs no target inspection. execute_sharur_100 writes these records and critical_fixes_attested to legion_100_audit_sitrep.json at 200-202.",
      "trigger": "Executing the script when any named audit target is absent or broken.",
      "impact": "Produces a machine-readable 100/100 passing attestation report unrelated to repository correctness; consumers may mistake simulation for measured audit evidence.",
      "confidence": "high",
      "kind": "example"
    }
  ],
