{
  "shard": "072",
  "findings": [
    {
      "title": "TLOAD is decoded as 0x5e instead of 0x5c",
      "severity": "P2",
      "path": "01_KISH_ENGINE/babylon60/bft/defi_bytecode_scraper.py",
      "line": 44,
      "evidence": "OPCODE_TLOAD = 0x5C + 2 is counted at lines 223-224; EIP-1153 specifies TLOAD=0x5c and TSTORE=0x5d (https://eips.ethereum.org/EIPS/eip-1153). bounty_pipeline_orchestrator.py:117,130-145 consumes these results for risk-based receipts.",
      "trigger": "Analyze bytecode containing 5c or 5e.",
      "impact": "Actual transient reads are missed and unrelated 0x5e instructions are labeled transient reads; balance heuristics and risk receipts become incorrect.",
      "confidence": "high",
      "kind": "runtime"
    },
    {
      "title": "Hook permissions use the most significant address bits",
      "severity": "P2",
      "path": "01_KISH_ENGINE/babylon60/bft/defi_bytecode_scraper.py",
      "line": 83,
      "evidence": "bits = (addr_int >> (160 - 14)) & 0x3FFF; official Hooks.sol uses the least significant bits (https://raw.githubusercontent.com/Uniswap/v4-core/main/src/libraries/Hooks.sol). analyze_bytecode consumes before_swap and delta flags at lines 287-299.",
      "trigger": "A hook address ends with 0080 while its high bits are zero, or high bits are set with low hook bits absent.",
      "impact": "Misses active BEFORE_SWAP and misattributes unrelated address bits as permissions, changing downstream risk decisions.",
      "confidence": "high",
      "kind": "runtime"
    },
    {
      "title": "Updating an existing engine key creates stale eviction entries",
      "severity": "P2",
      "path": "01_KISH_ENGINE/babylon60/engine/__init__.py",
      "line": 33,
      "evidence": "Every store appends record_key to _keys even when _store already contains it; eviction at lines 28-30 removes the dictionary record for the oldest occurrence. query iterates duplicate _keys at lines 41-46.",
      "trigger": "With capacity=2, store a, update a, then store b.",
      "impact": "Eviction removes the current updated a record although another a entry remains, and queries before eviction return duplicate copies of the latest record.",
      "confidence": "high",
      "kind": "runtime"
    },
    {
      "title": "Mail send announces delivery after only appending a local ledger event",
      "severity": "P2",
      "path": "scripts/c5_cli/babylon_mail_cli.py",
      "line": 89,
      "evidence": "cmd_send only constructs CortexEvent and calls ledger.append_event before printing [SENT] Correo enviado. The ledger append implementation persists a local row; no transport invocation occurs. tests/test_optional_mail_mcp.py:93 explicitly calls BABYLON_MAIL_SENT a compatibility event with no network delivery.",
      "trigger": "Run the advertised send subcommand expecting recipient delivery.",
      "impact": "User receives a successful delivery message although the mail is only stored locally; recipient never receives it through this command.",
      "confidence": "high",
      "kind": "runtime"
    },
    {
