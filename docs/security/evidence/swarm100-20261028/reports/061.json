    {
      "title": "Metadata writes can overwrite another manager\u2019s keys or revocations",
      "severity": "P1",
      "path": "01_KISH_ENGINE/babylon60/crypto/keys.py",
      "line": 85,
      "evidence": "Each KeyManager snapshots the complete JSON at initialization (77-83), then _save_metadata truncates and rewrites that snapshot (85-88), without locking or reloading. generate_and_store_key and revoke_key both invoke it.",
      "trigger": "Two manager instances load the same file; one revokes actor A, and the other subsequently generates actor B from its older snapshot.",
      "impact": "The second write restores stale revocation metadata and drops intervening updates; process termination during truncation can also leave unreadable metadata.",
      "confidence": "high",
      "kind": "runtime"
    },
    {
      "title": "Zero-weight agents still veto pooled hypotheses",
      "severity": "P2",
      "path": "01_KISH_ENGINE/babylon60/bft/bayesian_swarm.py",
      "line": 80,
      "evidence": "Weights default missing entries to zero (78), but p <= 0 vetoes the hypothesis before checking the weight (80-82).",
      "trigger": "Pool opinions with a zero-weight or omitted-weight agent assigning zero to a hypothesis supported by positive-weight agents.",
      "impact": "An excluded agent changes or zeros the result, violating weighted geometric pooling semantics.",
      "confidence": "high",
      "kind": "runtime"
    },
    {
      "title": "Garbage collection totals count each target repeatedly",
      "severity": "P2",
      "path": "scripts/c5_sharur/sharur_100_garbage_collector.py",
      "line": 106,
      "evidence": "Twenty workers per cohort choose rules using sub_idx % len(rules); cohort rule counts are below twenty. Lines 155-159 sum every repeated scan into cohort and global totals without deduplication.",
      "trigger": "Any matching file in one of the configured targets.",
      "impact": "Reported file and byte totals are inflated by repeated workers, making cleanup capacity reports inaccurate.",
      "confidence": "high",
      "kind": "runtime"
    },
    {
      "title": "Additional LSP headers are consumed as JSON payload bytes",
      "severity": "P2",
      "path": "01_KISH_ENGINE/cortex/crates/cortex-lsp/src/main.rs",
      "line": 47,
      "evidence": "After Content-Length, the parser reads exactly one line as an assumed empty delimiter (47-49), then consumes content_length bytes immediately (52-53).",
      "trigger": "An incoming message places a Content-Type header after Content-Length, followed by the actual empty line and JSON body.",
      "impact": "The extra header consumes the delimiter read and the remaining delimiter is included in the body; JSON parsing fails and stream framing is desynchronized.",
      "confidence": "high",
      "kind": "runtime"
    }
