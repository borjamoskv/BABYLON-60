{
  "$schema": "https://raw.githubusercontent.com/oasis-tcs/sarif-spec/master/Schemata/sarif-schema-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "MOSKV-1 Swarm Auditor (SOTA 2026)",
          "informationUri": "https://github.com/borjamoskv",
          "rules": [
            {
              "id": "SECRET-01",
              "name": "HardcodedSecret",
              "shortDescription": {
                "text": "Hardcoded key or secret string detected in codebase."
              },
              "helpUri": "https://github.com/borjamoskv"
            },
            {
              "id": "AST-SANDBOX-01",
              "name": "ASTSandboxEvasion",
              "shortDescription": {
                "text": "Unauthorized dunder attribute traversal or introspection call in sandboxed code."
              },
              "helpUri": "https://github.com/borjamoskv"
            },
            {
              "id": "BFT-FLOAT-01",
              "name": "FloatingPointInBFTConsensus",
              "shortDescription": {
                "text": "Floating point primitive detected in BFT payload violating INV_C5_18."
              },
              "helpUri": "https://github.com/borjamoskv"
            },
            {
              "id": "EIP-1153-01",
              "name": "ReentrancyWithoutTransientLock",
              "shortDescription": {
                "text": "Smart contract state mutation lacks EIP-1153 tstore/tload transient lock."
              },
              "helpUri": "https://github.com/borjamoskv"
            },
            {
              "id": "PYNACL-01",
              "name": "PyNaClAttributeAccessViolation",
              "shortDescription": {
                "text": "Accessing private _seed attribute on PyNaCl PrivateKey violates INV_C5_10."
              },
              "helpUri": "https://github.com/borjamoskv"
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "SECRET-01",
          "message": {
            "text": "Audit complete: 0 unmitigated hardcoded credentials in C5-REAL production tree. Test dummy mock key hash: fa8698f969d4d713"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "tests/test_stripe_webhook_handler.py"
                },
                "region": {
                  "startLine": 7,
                  "startColumn": 1
                }
              }
            }
          ]
        }
      ]
    }
  ]
}