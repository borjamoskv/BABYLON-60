{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Estado-Del-Arte-OMEGA I/O Contract",
  "type": "object",
  "properties": {
    "topic": {
      "type": "string",
      "description": "El límite topológico a investigar."
    },
    "timeframe_years": {
      "type": "integer",
      "default": 10,
      "description": "Años de retroceso permitidos."
    },
    "output_format": {
      "type": "string",
      "enum": ["markdown_noir", "json_sota", "ledger_commit"],
      "default": "markdown_noir"
    }
  },
  "required": ["topic"]
}
