{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Sovereign Extraction Schema",
  "type": "object",
  "properties": {
    "classes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": { "type": "string" },
          "docstring": { "type": ["string", "null"] },
          "methods": { "type": "array" },
          "line": { "type": "integer" }
        }
      }
    },
    "functions": { "type": "array" },
    "critical_paths": { "type": "array" },
    "sovereign_markers": { "type": "array" }
  },
  "required": ["classes", "functions", "critical_paths", "sovereign_markers"]
}
