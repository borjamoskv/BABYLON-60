{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cual.ai/schemas/zero-employee-orchestrator.json",
  "title": "Zero-Employee-Orchestrator-OMEGA I/O Contract",
  "type": "object",
  "properties": {
    "intent": {
      "type": "string",
      "description": "The business niche or operational goal to automate."
    },
    "budget_usd": {
      "type": "number",
      "minimum": 0
    },
    "vendor_categories": {
      "type": "array",
      "items": { "type": "string" },
      "description": "APIs to outsource (e.g., 'fulfillment', 'medical_compliance', 'customer_service')"
    }
  },
  "required": ["intent", "budget_usd", "vendor_categories"]
}
