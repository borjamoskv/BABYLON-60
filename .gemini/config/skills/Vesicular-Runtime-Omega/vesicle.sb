(version 1)
(deny default)
(allow process-exec (subpath "/opt/homebrew/opt/python@3.14/bin") (subpath "/opt/homebrew/Cellar/python@3.14/3.14.4/Frameworks/Python.framework/Versions/3.14/bin") (subpath "/opt/homebrew") (subpath "/usr/bin") (subpath "/bin"))
(allow file-read*)
(deny file-write*)
(allow file-write* (subpath "$CORTEX_ROOT/10_PROJECTS/borjamoskv-site"))
(allow file-write* (subpath "$CORTEX_ROOT/.gemini/antigravity"))
(allow file-write* (subpath "/tmp"))
(deny network*)