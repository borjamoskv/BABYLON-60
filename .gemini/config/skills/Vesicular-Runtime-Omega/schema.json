{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Vesicular-Runtime-Omega Intent Schema",
  "type": "object",
  "required": ["intent", "causal_parent", "requested_by"],
  "properties": {
    "intent": {
      "type": "string",
      "description": "The execution intent to bind to the runtime"
    },
    "causal_parent": {
      "type": "string",
      "description": "The upstream hash triggering this execution"
    },
    "requested_by": {
      "type": "string",
      "description": "Entity requesting the execution"
    },
    "sandbox_level": {
      "type": "string",
      "enum": ["L1-Standard", "L2-Isolated", "L3-Cryptographic"],
      "default": "L2-Isolated"
    }
  }
}
