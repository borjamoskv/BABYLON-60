{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "frontier-reveng-omega/v1.0.0",
  "title": "Frontier-RevEng-OMEGA I/O Contract",
  "description": "JSON Schema for Frontier AI Model Reverse Engineering operations",
  "type": "object",
  "properties": {
    "input": {
      "type": "object",
      "properties": {
        "command": {
          "type": "string",
          "enum": [
            "/reveng",
            "/reveng-probe",
            "/reveng-compare",
            "/reveng-safety",
            "/reveng-arch",
            "/reveng-training",
            "/reveng-tokenizer",
            "/reveng-report",
            "/reveng-diff"
          ]
        },
        "target_model": { "type": "string" },
        "target_model_2": { "type": "string" },
        "layer": {
          "type": "string",
          "enum": ["L0", "L1", "L2", "L3", "L4", "L5", "L6"]
        },
        "probe_config": {
          "type": "object",
          "properties": {
            "n_probes": { "type": "integer", "minimum": 1, "default": 10 },
            "temperature": { "type": "number", "minimum": 0, "maximum": 2, "default": 0 },
            "modules": {
              "type": "array",
              "items": { "type": "string", "enum": ["A", "B", "C", "D", "E"] }
            }
          }
        },
        "ethics_override": { "type": "boolean", "const": false }
      },
      "required": ["command", "target_model"]
    },
    "output": {
      "type": "object",
      "properties": {
        "model_dossier": { "type": "object" },
        "status": { "type": "string", "enum": ["COMPLETE", "PARTIAL", "ABORTED"] },
        "ethics_gate_passed": { "type": "boolean" }
      },
      "required": ["status", "ethics_gate_passed"]
    }
  },
  "required": ["input", "output"]
}
