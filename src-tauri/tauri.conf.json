{
  "productName": "moskv-1-apex",
  "version": "1.0.0",
  "identifier": "com.moskv.apex",
  "build": {
    "beforeDevCommand": "",
    "beforeBuildCommand": "",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "MOSKV-1 APEX SINGULARITY",
