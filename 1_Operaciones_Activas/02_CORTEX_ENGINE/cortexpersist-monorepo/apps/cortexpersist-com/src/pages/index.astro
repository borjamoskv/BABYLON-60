---
import Layout from '../layouts/Layout.astro';
import { CrossDomainCTA } from '@cortex/ui';

import QuickstartSnippet from '@/components/QuickstartSnippet';
import PricingSection from '@/components/PricingSection';
import SwarmTelemetryLog from '@/components/SwarmTelemetryLog';
import ManualCollisionInjector from '@/components/ManualCollisionInjector';
---

<Layout
  title="BABYLON 60 — Trust Infrastructure & EU AI Act Compliance for Autonomous AI"
  description="Sovereign memory & immutability substrate for AI agent teams. EU AI Act compliance, cryptographic lineage, and <5ms latency."
>
  <main style="min-height: 100vh; background: #030303; color: #e0e0e0; font-family: system-ui, -apple-system, sans-serif;">

    {/* Urgency Banner */}
    <div style="background: linear-gradient(90deg, #FF5252, #FF9F1C); color: #000; font-weight: 700; text-align: center; padding: 0.6rem 1rem; font-size: 0.85rem; font-family: monospace;">
      ⚠️ EU AI ACT ENFORCEMENT (AUGUST 2026): Non-compliant AI systems face fines up to €30M. <a href="#pricing" style="color: #000; underline: true; margin-left: 0.5rem;">Explore Enterprise Compliance Tiers →</a>
    </div>

    {/* Hero Section */}
    <section style="padding: 5rem 2rem 3rem; text-align: center; max-width: 1000px; margin: 0 auto;">
      <div style="display: inline-block; padding: 0.4rem 1rem; background: rgba(43, 59, 229, 0.15); border: 1px solid rgba(43, 59, 229, 0.4); border-radius: 999px; color: #60a5fa; font-family: monospace; font-size: 0.8rem; font-weight: 600; margin-bottom: 1.5rem;">
        ⚡ B2B SaaS & Enterprise Sovereign Engine
      </div>
      <h1 style="font-size: clamp(2.8rem, 6vw, 5rem); font-weight: 900; line-height: 1.05; letter-spacing: -0.02em; color: #FFFFFF; margin-bottom: 1.5rem;">
        Prove your AI agents' integrity <span style="color: #2B3BE5;">in &lt;5ms</span>.
      </h1>
      <p style="font-size: 1.25rem; color: rgba(255,255,255,0.7); max-width: 750px; margin: 0 auto 2.5rem; line-height: 1.6;">
        BABYLON 60 is the deterministic memory substrate with Ed25519/SHA3-256 cryptographic signatures for autonomous agent teams. Zero cloud lock-in, 100% auditable.
      </p>

      {/* Hero CTAs */}
      <div style="display: flex; gap: 15px; justify-content: center; flex-wrap: wrap; margin-bottom: 4rem;">
        <a href="#pricing" style="background: #2B3BE5; color: #fff; padding: 1rem 2.2rem; border-radius: 8px; font-weight: 700; text-decoration: none; font-size: 1.1rem; boxShadow: 0 0 25px rgba(43,59,229,0.5);">
          Get Pro License ($49/mo)
        </a>
        <a href="#quickstart" style="background: rgba(255,255,255,0.08); color: #fff; border: 1px solid rgba(255,255,255,0.2); padding: 1rem 2.2rem; border-radius: 8px; font-weight: 700; text-decoration: none; font-size: 1.1rem;">
          Quickstart SDK (30s)
        </a>
      </div>

      {/* Quickstart Component */}
      <div id="quickstart">
        <QuickstartSnippet client:only="react" />
      </div>
    </section>

    {/* Live Telemetry Section */}
    <section style="padding: 4rem 2rem; max-width: 1000px; margin: 0 auto;">
      <SwarmTelemetryLog client:only="react" />
    </section>

    {/* Pricing & Commercial Section */}
    <PricingSection client:only="react" />

    {/* Manual Collision Test (Interactive Proof) */}
    <section style="padding: 2rem 2rem 5rem; max-width: 1000px; margin: 0 auto;">
      <ManualCollisionInjector client:only="react" />
    </section>

  </main>
</Layout>
