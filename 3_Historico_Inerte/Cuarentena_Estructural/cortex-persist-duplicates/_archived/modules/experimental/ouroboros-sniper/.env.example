# OUROBOROS SNIPER — Variables de Entorno Soberanas
# Mandato Ω₉: Este archivo NUNCA hace commit. Añadir a .gitignore inmediatamente.

# Telegram MTProto API (Obtener en my.telegram.org)
TG_API_ID=YOUR_API_ID_HERE
TG_API_HASH=YOUR_API_HASH_HERE

# GitHub Token (Personal Access Token para monitoreo de eventos)
GH_TOKEN=YOUR_GITHUB_TOKEN_HERE

# Discord Token (User or Bot token)
DISCORD_TOKEN=YOUR_DISCORD_TOKEN_HERE

# Wallet soberana (ECC / secp256k1) — Clave privada en RAM, NUNCA en disco en producción.
SOVEREIGN_PRIVATE_KEY=0xYOUR_PRIVATE_KEY_HERE

# Dirección del contrato OuroborosExecutor.sol desplegado (post-forge deploy)
EXECUTOR_CONTRACT=0xYOUR_EXECUTOR_CONTRACT_HERE

# Flashbots RPC (Ethereum Mainnet)
FLASHBOTS_RELAY_URL=https://relay.flashbots.net

# Red objetivo (ethereum / bsc / arbitrum)
TARGET_CHAIN=ethereum

# WebSocket RPC (Necesario para Mirroring / Mempool monitoring)
RPC_WS_URL=ws://127.0.0.1:8546

# Whitelist de Alpha Wallets (Separadas por coma)
ALPHA_WALLETS=0x83B80Fd80FeB41846b0E3dD7eC04677762692237,0xD959730E78028D59a686Ba3D063A483E016d9CC7
