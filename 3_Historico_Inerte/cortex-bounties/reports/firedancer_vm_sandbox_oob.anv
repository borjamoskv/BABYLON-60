// Firedancer VM Sandbox OOB Verification (C5-REAL)
// Model: OUROBOROS-FD-VM-01/02
// Goal: Prove that region index 12 leaks the input_mem_regions pointer.

fn verify_oob_leak_v6(
    vaddr: u64,
    input_mem_regions: u64,
    mut leaked_ptr: u64
) 
assumes {
    // Axiom: Virtual address to region index shift
    // We model the specific index 12 calculation
    vaddr == 51539607552, // 12 << 32
    input_mem_regions == 244837814037246 // 0xDEADBEEFCAFE
}
where {
    // Postcondition: leaked_ptr must equal input_mem_regions
    leaked_ptr' == input_mem_regions
}
{
    // The vulnerable lookup logic
    // In fd_vm_mem_haddr, there is no check if region < 6
    let region: u64 = vaddr / 4294967296; // 4294967296 = 2^32
    
    // We model the memory layout of fd_vm_t
    // region_haddr[6]  (0-47 bytes)
    // region_ld_sz[6]  (48-71 bytes)
    // region_st_sz[6]  (72-95 bytes)
    // input_mem_regions (96 bytes)
    
    // Branchless lookup: region == 12 is 1 if true, 0 if false
    leaked_ptr = (region == 12) * input_mem_regions;
}
